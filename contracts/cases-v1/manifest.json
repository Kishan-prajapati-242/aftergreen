{
  "schema": "aftergreen.bundle-cases.v1",
  "contract": "aftergreen.bundle.v1",
  "cases": [
    {
      "id": "valid-collected-job-log",
      "note": "synthetic data in the collected_public shape: a present, redacted, selected job log; three sources not collected",
      "input": {
        "file": "valid-collected-job-log.json"
      },
      "expect": {
        "result": "accept",
        "evidence_sha256": "e2afa127d36619e339a4ab6e67ee2d101b27b21b6128c0b82a93010317a3f25b"
      }
    },
    {
      "id": "valid-simulated-log-missing",
      "note": "simulated: the job log was refused, nothing else collected, redaction none",
      "input": {
        "file": "valid-simulated-log-missing.json"
      },
      "expect": {
        "result": "accept",
        "evidence_sha256": "43331f0003e0af4a0302315261c1d14cbbc77e8fa8f7e977f3c73f42c092cc2d"
      }
    },
    {
      "id": "valid-producer-fixture",
      "note": "simulated: the Go producer's output for the offline fixture collection in collector/github/bundle_test.go",
      "input": {
        "file": "valid-producer-fixture.json"
      },
      "expect": {
        "result": "accept",
        "evidence_sha256": "e84636121f38103f29cdb919e3d6429605d9b1983c85c47a5f367db9018793be"
      }
    },
    {
      "id": "accept-missing-workflow-without-path",
      "note": "a missing file may omit path",
      "input": {
        "base": "valid-collected-job-log.json",
        "replace": [
          {
            "find": "\"status\": \"missing\",\n      \"path\": \".github/workflows/ci.yml\",\n      \"missing_reason\": \"not_collected\"",
            "with": "\"status\": \"missing\",\n      \"missing_reason\": \"not_collected\""
          },
          {
            "find": "\"evidence_sha256\": \"e2afa127d36619e339a4ab6e67ee2d101b27b21b6128c0b82a93010317a3f25b\"",
            "with": "\"evidence_sha256\": \"af2d2daa5a770f2e9e4cdcfcdd7f10db8ebaf6527ccc0d01bbbd28b227feff30\""
          }
        ]
      },
      "expect": {
        "result": "accept",
        "evidence_sha256": "af2d2daa5a770f2e9e4cdcfcdd7f10db8ebaf6527ccc0d01bbbd28b227feff30"
      }
    },
    {
      "id": "accept-extent-prefix",
      "note": "extent prefix",
      "input": {
        "base": "valid-collected-job-log.json",
        "replace": [
          {
            "find": "\"extent\": \"complete\"",
            "with": "\"extent\": \"prefix\""
          },
          {
            "find": "\"evidence_sha256\": \"e2afa127d36619e339a4ab6e67ee2d101b27b21b6128c0b82a93010317a3f25b\"",
            "with": "\"evidence_sha256\": \"6d0a25ecfbb01a9a3fef376d0b7af8687106a6da8df49006cbc5e87375d22d99\""
          }
        ]
      },
      "expect": {
        "result": "accept",
        "evidence_sha256": "6d0a25ecfbb01a9a3fef376d0b7af8687106a6da8df49006cbc5e87375d22d99"
      }
    },
    {
      "id": "accept-extent-partial",
      "note": "extent partial",
      "input": {
        "base": "valid-collected-job-log.json",
        "replace": [
          {
            "find": "\"extent\": \"complete\"",
            "with": "\"extent\": \"partial\""
          },
          {
            "find": "\"evidence_sha256\": \"e2afa127d36619e339a4ab6e67ee2d101b27b21b6128c0b82a93010317a3f25b\"",
            "with": "\"evidence_sha256\": \"bfab855eda790e2faf71b602442ed23380dbe9b460face8f8a4c8c0cf9419b20\""
          }
        ]
      },
      "expect": {
        "result": "accept",
        "evidence_sha256": "bfab855eda790e2faf71b602442ed23380dbe9b460face8f8a4c8c0cf9419b20"
      }
    },
    {
      "id": "accept-authentication-none",
      "note": "a log requested without a credential",
      "input": {
        "base": "valid-collected-job-log.json",
        "replace": [
          {
            "find": "\"authentication\": \"gh_cli\"",
            "with": "\"authentication\": \"none\""
          },
          {
            "find": "\"evidence_sha256\": \"e2afa127d36619e339a4ab6e67ee2d101b27b21b6128c0b82a93010317a3f25b\"",
            "with": "\"evidence_sha256\": \"d2077981bb2be93d302c1affa5b06e9c896690ace1fc1b8599c8b6073dcfa795\""
          }
        ]
      },
      "expect": {
        "result": "accept",
        "evidence_sha256": "d2077981bb2be93d302c1affa5b06e9c896690ace1fc1b8599c8b6073dcfa795"
      }
    },
    {
      "id": "accept-tab-in-line",
      "note": "tab is allowed in line text",
      "input": {
        "base": "valid-collected-job-log.json",
        "replace": [
          {
            "find": "Cleaning up orphan processes",
            "with": "Cleaning\\tup orphan processes"
          },
          {
            "find": "\"evidence_sha256\": \"e2afa127d36619e339a4ab6e67ee2d101b27b21b6128c0b82a93010317a3f25b\"",
            "with": "\"evidence_sha256\": \"e3a04bab676c91b90c93fb737c1304e1a9be0da7bfa1f1eef2a94a4a976778cb\""
          }
        ]
      },
      "expect": {
        "result": "accept",
        "evidence_sha256": "e3a04bab676c91b90c93fb737c1304e1a9be0da7bfa1f1eef2a94a4a976778cb"
      }
    },
    {
      "id": "accept-matrix-resolved",
      "note": "a resolved matrix value is a v1 display string",
      "input": {
        "base": "valid-collected-job-log.json",
        "replace": [
          {
            "find": "\"matrix\": {\n        \"status\": \"unresolved\",\n        \"reason\": \"workflow_not_collected\",\n        \"evidence\": []\n      },",
            "with": "\"matrix\": {\n        \"status\": \"resolved\",\n        \"values\": [\n          {\n            \"key\": \"browser\",\n            \"value\": \"chromium\"\n          }\n        ],\n        \"evidence\": []\n      },"
          },
          {
            "find": "\"evidence_sha256\": \"e2afa127d36619e339a4ab6e67ee2d101b27b21b6128c0b82a93010317a3f25b\"",
            "with": "\"evidence_sha256\": \"d47b2b3c6c201299bce17977865010f214a2618049fd352d2d1615e6f2780db9\""
          }
        ]
      },
      "expect": {
        "result": "accept",
        "evidence_sha256": "d47b2b3c6c201299bce17977865010f214a2618049fd352d2d1615e6f2780db9"
      }
    },
    {
      "id": "accept-format-character-in-line",
      "note": "format characters such as U+202E are accepted; later stages must show them",
      "input": {
        "base": "valid-collected-job-log.json",
        "replace": [
          {
            "find": "Run npm test",
            "with": "Run npm test \\u202e"
          },
          {
            "find": "\"evidence_sha256\": \"e2afa127d36619e339a4ab6e67ee2d101b27b21b6128c0b82a93010317a3f25b\"",
            "with": "\"evidence_sha256\": \"9c30db7d66e226e517878a0163e1edfa696f282a55da4b9c6f0dc6bab480fb06\""
          }
        ]
      },
      "expect": {
        "result": "accept",
        "evidence_sha256": "9c30db7d66e226e517878a0163e1edfa696f282a55da4b9c6f0dc6bab480fb06"
      }
    },
    {
      "id": "input-too-large",
      "note": "131,073 bytes",
      "input": {
        "base": "valid-collected-job-log.json",
        "pad_to_bytes": 131073
      },
      "expect": {
        "result": "reject",
        "code": "input_too_large"
      }
    },
    {
      "id": "invalid-utf8",
      "note": "a raw 0xFF byte",
      "input": {
        "raw_hex": "7b22736368656d61223a22ff227d"
      },
      "expect": {
        "result": "reject",
        "code": "invalid_utf8"
      }
    },
    {
      "id": "invalid-json-trailing-comma",
      "note": "trailing comma",
      "input": {
        "raw": "{\"schema\": \"aftergreen.bundle.v1\",}"
      },
      "expect": {
        "result": "reject",
        "code": "invalid_json"
      }
    },
    {
      "id": "nesting-too-deep",
      "note": "17 nested arrays",
      "input": {
        "raw": "[[[[[[[[[[[[[[[[[0]]]]]]]]]]]]]]]]]"
      },
      "expect": {
        "result": "reject",
        "code": "nesting_too_deep"
      }
    },
    {
      "id": "matrix-value-c1-control",
      "note": "v1 display strings forbid C1 controls, matrix values included (U+009B is the 8-bit CSI)",
      "input": {
        "base": "valid-collected-job-log.json",
        "replace": [
          {
            "find": "\"matrix\": {\n        \"status\": \"unresolved\",\n        \"reason\": \"workflow_not_collected\",\n        \"evidence\": []\n      },",
            "with": "\"matrix\": {\n        \"status\": \"resolved\",\n        \"values\": [\n          {\n            \"key\": \"browser\",\n            \"value\": \"ubuntu\\u009b2J\"\n          }\n        ],\n        \"evidence\": []\n      },"
          }
        ]
      },
      "expect": {
        "result": "reject",
        "code": "schema_violation",
        "pointer": "/runs/0/matrix/values/0/value"
      }
    },
    {
      "id": "duplicate-key",
      "note": "case_id twice",
      "input": {
        "base": "valid-collected-job-log.json",
        "replace": [
          {
            "find": "\"case_id\": \"synthetic-collected-shape\",",
            "with": "\"case_id\": \"synthetic-collected-shape\",\n  \"case_id\": \"case-v1-other\","
          }
        ]
      },
      "expect": {
        "result": "reject",
        "code": "duplicate_key"
      }
    },
    {
      "id": "invalid-number-fraction",
      "note": "1.0 is not an integer",
      "input": {
        "base": "valid-collected-job-log.json",
        "replace": [
          {
            "find": "\"run_attempt\": 1,",
            "with": "\"run_attempt\": 1.0,"
          }
        ]
      },
      "expect": {
        "result": "reject",
        "code": "invalid_number"
      }
    },
    {
      "id": "evaluator-field",
      "note": "an expected answer in an input bundle",
      "input": {
        "base": "valid-collected-job-log.json",
        "replace": [
          {
            "find": "\"case_id\": \"synthetic-collected-shape\",",
            "with": "\"case_id\": \"synthetic-collected-shape\",\n  \"expected_diagnosis\": \"x\","
          }
        ]
      },
      "expect": {
        "result": "reject",
        "code": "evaluator_field",
        "pointer": "/expected_diagnosis"
      }
    },
    {
      "id": "unknown-field-bundle",
      "note": "unknown top-level member",
      "input": {
        "base": "valid-collected-job-log.json",
        "replace": [
          {
            "find": "\"created_at\": \"2026-11-10T12:00:00Z\",",
            "with": "\"created_at\": \"2026-11-10T12:00:00Z\",\n  \"notes\": \"x\","
          }
        ]
      },
      "expect": {
        "result": "reject",
        "code": "unknown_field",
        "pointer": "/notes"
      }
    },
    {
      "id": "unknown-field-collection",
      "note": "unknown collection member",
      "input": {
        "base": "valid-collected-job-log.json",
        "replace": [
          {
            "find": "\"tool\": \"aftergreen-collect\",",
            "with": "\"tool\": \"aftergreen-collect\",\n    \"host\": \"github.com\","
          }
        ]
      },
      "expect": {
        "result": "reject",
        "code": "unknown_field",
        "pointer": "/collection/host"
      }
    },
    {
      "id": "unknown-field-source",
      "note": "a source cannot carry a URL",
      "input": {
        "base": "valid-collected-job-log.json",
        "replace": [
          {
            "find": "\"kind\": \"job_log\",",
            "with": "\"kind\": \"job_log\",\n      \"url\": \"https://example.invalid/log\","
          }
        ]
      },
      "expect": {
        "result": "reject",
        "code": "unknown_field",
        "pointer": "/sources/0/url"
      }
    },
    {
      "id": "schema-v0",
      "note": "a v1 validator accepts only v1",
