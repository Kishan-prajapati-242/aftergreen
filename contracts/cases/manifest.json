{
  "schema": "aftergreen.bundle-cases.v0",
  "contract": "aftergreen.bundle.v0",
  "cases": [
    {
      "id": "valid-simulated-stale-lockfile",
      "note": "Hand-written simulated stale-lockfile failure with a passing baseline.",
      "input": {
        "file": "valid-simulated-stale-lockfile.json"
      },
      "expect": {
        "result": "accept",
        "evidence_sha256": "137735478ea44614d86c00fa40c16bfeb709bb744566be69fae9006e49cc566a"
      }
    },
    {
      "id": "valid-missing-baseline-log",
      "note": "Baseline job log declared missing (expired); evidence that needed it is unresolved or empty.",
      "input": {
        "file": "valid-missing-baseline-log.json"
      },
      "expect": {
        "result": "accept",
        "evidence_sha256": "73087decf7af892f0db7bbafe8956b8a29a2e504b898be5f0c9ab88d9ab70683"
      }
    },
    {
      "id": "accept-input-exactly-128kib",
      "note": "Trailing whitespace pads the raw input to exactly 131072 bytes.",
      "input": {
        "base": "valid-simulated-stale-lockfile.json",
        "pad_to_bytes": 131072
      },
      "expect": {
        "result": "accept",
        "evidence_sha256": "137735478ea44614d86c00fa40c16bfeb709bb744566be69fae9006e49cc566a"
      }
    },
    {
      "id": "accept-line-exactly-2048-bytes",
      "note": "1024 x U+00E9 is 2048 UTF-8 bytes; the digest changes with the text.",
      "input": {
        "base": "valid-simulated-stale-lockfile.json",
        "replace": [
          {
            "find": "2026-11-02T14:03:11.0000000Z shell: /usr/bin/bash -e {0}",
            "with_repeat": {
              "item": "é",
              "count": 1024,
              "separator": ""
            }
          },
          {
            "find": "137735478ea44614d86c00fa40c16bfeb709bb744566be69fae9006e49cc566a",
            "with": "da95be534dce69da8901074bf1d9669e96d8da4902a210d86713d48050707abe"
          }
        ]
      },
      "expect": {
        "result": "accept",
        "evidence_sha256": "da95be534dce69da8901074bf1d9669e96d8da4902a210d86713d48050707abe"
      }
    },
    {
      "id": "accept-escaped-unicode-same-digest",
      "note": "Writing U+2714 as a JSON escape does not change the digest.",
      "input": {
        "base": "valid-simulated-stale-lockfile.json",
        "replace": [
          {
            "find": "✔ health check",
            "with": "\\u2714 health check"
          }
        ]
      },
      "expect": {
        "result": "accept",
        "evidence_sha256": "137735478ea44614d86c00fa40c16bfeb709bb744566be69fae9006e49cc566a"
      }
    },
    {
      "id": "input-over-128kib",
      "input": {
        "base": "valid-simulated-stale-lockfile.json",
        "pad_to_bytes": 131073
      },
      "expect": {
        "result": "reject",
        "code": "input_too_large"
      }
    },
    {
      "id": "precedence-size-before-utf8",
      "note": "Oversized and malformed: size is checked first.",
      "input": {
        "base": "valid-simulated-stale-lockfile.json",
        "replace": [
          {
            "find": "sim-0001",
            "with_hex": "73696d2dff"
          }
        ],
        "pad_to_bytes": 131073
      },
      "expect": {
        "result": "reject",
        "code": "input_too_large"
      }
    },
    {
      "id": "invalid-utf8-byte",
