    },
    {
      "id": "nesting-17-levels",
      "input": {
        "raw": "[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]"
      },
      "expect": {
        "result": "reject",
        "code": "nesting_too_deep"
      }
    },
    {
      "id": "nesting-16-levels-parses",
      "note": "16 levels parse; the top-level value is then not an object.",
      "input": {
        "raw": "[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]"
      },
      "expect": {
        "result": "reject",
        "code": "schema_violation"
      }
