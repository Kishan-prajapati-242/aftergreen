            "find": "\"case_id\": \"sim-0001\",",
            "with": "\"case_id\": \"sim-0001\",\n  \"acceptable_hypotheses\": [\"stale lockfile\"],"
          },
          {
            "find": "\"redaction\": \"none\",",
            "with": "\"redaction\": \"none\",\n  \"redaction\": \"none\","
